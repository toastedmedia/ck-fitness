# Environment variables for the web app. Copy to .env.local for local development and fill in
# STAGING values. In production every value lives in Vercel (Project -> Settings -> Environment
# Variables), never in the repo. NEXT_PUBLIC_* values are visible in the browser; everything else is
# server only. Optional ones switch a feature off when empty.

# --- Required ---------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://app.chardikalafitness.com
# Long random string. Signs cron calls, unsubscribe links, the calendar feed address and the
# Google sign-in check. Do not rotate (old unsubscribe links would stop working).
CRON_SECRET=

# --- Email (Resend) ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Chardikala Fitness <no-reply@chardikalafitness.com>
EMAIL_REPLY_TO=support@chardikalafitness.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@chardikalafitness.com

# --- Video (Cloudflare R2 + streaming job on GitHub) -------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Lets the video job ask for its list (also a GitHub secret). See docs/STORAGE.md.
VIDEO_JOB_SECRET=
# Optional: start the streaming job automatically after an upload.
GITHUB_ACTIONS_TOKEN=
GITHUB_REPO=toastedmedia/ck-fitness

# --- Payments (Stripe; self-serve purchase is switched off in lib/flags.ts) --------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Ads tracking (website and browser only, never the store apps) -----------------------------
NEXT_PUBLIC_GA_ID=G-GV1Q50JX1X
NEXT_PUBLIC_META_PIXEL_ID=3281655158675256
# Meta Conversions API token (Events Manager -> dataset -> Settings). Optional test code TEST12345.
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=

# --- Google Calendar two-way sync for consultations (Admin -> Calendar) ------------------------
# Google Cloud project "Chardikala Fitness" -> OAuth client (Web), redirect
# https://app.chardikalafitness.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional features ------------------------------------------------------------------------
# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chardikalafitness.com
# Hidden CK Nutrition AI meal scanner
OPENAI_API_KEY=
OPENAI_NUTRITION_MODEL=gpt-4o-mini
# Toasted Media CRM sync (Admin -> CRM sync)
TOASTED_CRM_API_BASE_URL=
TOASTED_CRM_API_TOKEN=
TOASTED_CRM_WORKSPACE_ID=
# Error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Local only: preview pages under /dev
CK_DEV_PREVIEW=
